# Environment variables for Visant Labs
# Copy to .env and fill in your values

# ── AI Providers ──
GEMINI_API_KEY=
OPENAI_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
APIFREE_API_KEY=
BYTEPLUS_API_KEY=
IDEOGRAM_API_KEY=
REVE_API_KEY=

# ── Visant API ──
VISANT_API_TOKEN=

# ── Database ──
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/mockup-machine
MONGODB_DB_NAME=mockup-machine

# ── Server ──
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
JWT_SECRET=

# ── Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Stripe ──
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRODUCT_ID=
STRIPE_PRICE_ID_USD=
STRIPE_PRICE_ID_BRL=
STRIPE_PRODUCT_20=
STRIPE_PRODUCT_50=
STRIPE_PRODUCT_100=
STRIPE_PRODUCT_500=

# ── Better Auth ──
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000/

# ── Cloudflare R2 Storage ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Frontend (Vite) ──
VITE_FRONTEND_URL=http://localhost:3000
VITE_GEMINI_API_KEY=
VITE_LOGO_DEV_TOKEN=

# ── PostHog (product analytics — optional, no-op if empty) ──
# Project token from https://us.posthog.com (Cloud free tier, US region — Project Settings → Project token)
VITE_POSTHOG_KEY=
# Optional override; defaults to /ph (Vercel proxy) in prod, us.i.posthog.com in dev
VITE_POSTHOG_HOST=

# ── Liveblocks (Collaboration) ──
VITE_LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_PUBLIC_KEY=
LIVEBLOCKS_SECRET_KEY=
LIVEBLOCKS_WEBHOOK_SECRET=

# ── AbacatePay (PIX) ──
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
ABACATEPAY_WEBHOOK_ID=
ABACATE_PRODUCT_20=
ABACATE_PRODUCT_50=
ABACATE_PRODUCT_100=
ABACATE_PRODUCT_500=

# ── Resend (Email) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_WEBHOOK_KEY=
# IDs de template do dashboard do Resend. Vazio = usa o HTML embutido no
# emailService.ts, que é o padrão e já está no visual da marca.
RESEND_TEMPLATE_WELCOME=
RESEND_TEMPLATE_PASSWORD_RESET=
RESEND_TEMPLATE_EMAIL_VERIFICATION=
RESEND_TEMPLATE_CREDITS_PURCHASED=
RESEND_TEMPLATE_NEWSLETTER_WELCOME=
# Jornada de downgrade de marca: aviso, lembrete de 48h e confirmação.
RESEND_TEMPLATE_BRAND_QUOTA_DOWNGRADE=
RESEND_TEMPLATE_BRAND_QUOTA_REMINDER=
RESEND_TEMPLATE_BRAND_QUOTA_ARCHIVED=

# ── Cron ──
CRON_SECRET=

# ── hCaptcha ──
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
VITE_HCAPTCHA_SITE_KEY=

# ── API Key Encryption ──
API_KEY_ENCRYPTION_KEY=

# ── Rate Limiting ──
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=3600000
RATE_LIMIT_MAX_SIGNUP=3
RATE_LIMIT_MAX_SIGNIN=10

# ── Firecrawl / Serper ──
FIRECRAWL_API_KEY=
SERPER_API_KEY=

# ── Redis ──
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ── Ollama (Local LLM) ──
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4
DEFAULT_LLM_PROVIDER=ollama

# ── Digital Ocean Spaces (PSD mockup storage) ──
DO_API_TOKEN=
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=boxy
DO_SPACES_CDN_URL=https://boxy.nyc3.cdn.digitaloceanspaces.com

# ── Feature Flags (backend) ──
FEATURE_REFLECTION_LOOP=false
PATTERN_PROMOTION_THRESHOLD=5
AUTO_PROMOTE_PATTERNS=true

# ── Feature Flags (frontend / Vite) ──
# Semântica (src/config/featureFlags.ts): env explícita 'true'/'false' sempre
# vence; SEM valor definido → liga só em dev (import.meta.env.DEV) e DESLIGA em
# build de produção. Por isso prod precisa destes setados EXPLICITAMENTE no
# dashboard Vercel — senão o diferencial brand-first sobe dark.
VITE_FEATURE_COCKPIT=true          # rota /cockpit + entrada no launcher
VITE_FEATURE_COCKPIT_HOME=true     # home logada '/' redireciona pro cockpit
VITE_FEATURE_ONBOARDING_V2=true    # onboarding brand-first (wizard v2 + checklist)
VITE_FEATURE_FUNNEL_BANNER=true    # banner "conecte sua marca" nas free tools
VITE_FEATURE_BRAND_BILLING=false   # billing por marca — só ligar após o e-mail de grace de downgrade
VITE_FEATURE_COPILOT=false         # rota /copilot paga — ligar quando o Copilot estiver pronto
