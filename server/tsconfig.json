{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": "../",
    "baseUrl": "../",
    "paths": {
      "@/*": ["./src/*"]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "**/*.ts",
    "../src/services/r2Service.ts",
    "../src/services/geminiService.ts",
    "../types/types.ts",
    "../node_modules/vite/client.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
